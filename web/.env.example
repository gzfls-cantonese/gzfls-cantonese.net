# Base URL for dataset assets (manifest.json, episodes/, audio/).
# Dev default serves ../dist-assets via the Vite middleware at /data.
# In production the dataset lives at a STABLE prefix <PREFIX>/data/ (default
# sanguo/data/), outside the versioned site dir, so point this at that stable
# location, e.g. https://<your-domain-or-cdn>/sanguo/data
# A root-relative /data only works if the site origin can reach sanguo/data;
# when the origin maps to the version dir, use the absolute URL above instead.
VITE_ASSET_BASE=/data

# Base URL of the recordings serverless function (presign-upload / dispose).
# Unset => the trial-recording UI is not rendered at all (also the rollback
# switch). For local dev, run server/recordings with RECORDINGS_LOCAL_DIR and
# point this at it, e.g. http://localhost:8799
# VITE_RECORDINGS_API=http://localhost:8799
